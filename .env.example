# ---------------------------------------------------------------------------
# Raeucherhaken24 - Beispielkonfiguration
# Kopieren nach .env und Werte ersetzen. Die .env selbst gehoert NICHT ins Git.
# ---------------------------------------------------------------------------

# Datenbank
# Entwicklung (SQLite, keine Installation noetig):
DATABASE_URL="file:./dev.db"
# Produktion (PostgreSQL) - dafuer zusaetzlich den provider in
# prisma/schema.prisma auf "postgresql" umstellen, siehe README:
# DATABASE_URL="postgresql://benutzer:passwort@host:5432/raeucherhaken24?schema=public"

# Oeffentliche Basis-URL des Shops (ohne abschliessenden Slash).
# Wird fuer Canonical-URLs, Sitemap, Open Graph und strukturierte Daten benoetigt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Pepper fuer die Pseudonymisierung von IP-Adressen (Rate-Limiting, Protokoll).
# In Produktion zwingend durch einen langen Zufallswert ersetzen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SECRET="bitte-ersetzen-durch-langen-zufallswert"

# Ablageort fuer Datei-Uploads aus dem Sonderanfertigungsformular.
# Muss ausserhalb des oeffentlichen Verzeichnisses liegen.
UPLOAD_DIR="./storage/uploads"

# ---------------------------------------------------------------------------
# Optionale externe Dienste
# Ohne diese Werte laeuft der Shop vollstaendig; die betroffenen Funktionen
# nutzen dann die dokumentierten lokalen Ersatzimplementierungen.
# ---------------------------------------------------------------------------

# E-Mail-Versand (Bestellbestaetigung, Supportbenachrichtigung).
# Ohne Konfiguration werden E-Mails in die Serverkonsole geschrieben.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
MAIL_FROM="bestellung@raeucherhaken24.example"
MAIL_SUPPORT="service@raeucherhaken24.example"

# KI-Anbieter fuer den Raeucherberater "Smoky".
# Ohne Schluessel arbeitet Smoky mit der regelbasierten Empfehlungslogik
# auf Basis des echten Produktkatalogs (siehe README).
# ANTHROPIC_API_KEY=""
# SMOKY_MODEL="claude-sonnet-4-5"
