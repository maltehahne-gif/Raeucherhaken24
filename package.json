{
  "name": "raeucherhaken24",
  "version": "1.0.0",
  "private": true,
  "description": "Premium E-Commerce-Plattform fuer professionellen Raeucherbedarf",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "check:pages": "tsx scripts/check-pages.ts",
    "check:flow": "tsx scripts/smoke-test.ts",
    "check:a11y": "tsx scripts/check-a11y.ts",
    "check:admin": "tsx scripts/check-admin-api.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "lucide-react": "0.544.0",
    "next": "15.5.24",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.7"
  }
}
